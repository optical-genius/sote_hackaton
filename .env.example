# ==============================================================================
# Sopi (LUVN Previsit System) - Template Configuration
# ==============================================================================

WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

OPENAI_API_KEY=
GEMINI_API_KEY=

# Local Mode (LM Studio on port 1234)
LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1
LM_STUDIO_MODEL=medicus
LM_STUDIO_API_KEY=

# EC2 Dev-Stage Mode (vLLM on port 8001)
# MEDICUS_API_URL=http://localhost:8001/v1
# MEDICUS_MODEL=medicus
# MEDICUS_API_KEY=

# AI Operational Mode:
# When set to false (default for presentations & high traffic):
# Instant response with 2.0s realistic AI thinking delay and tailored clinical questions for all 8 patients.
# When set to true: queries live Medicus / LM Studio model.
USE_REAL_AI_MODEL=false

FRONTEND_PORT=3000
BACKEND_PORT=8000

